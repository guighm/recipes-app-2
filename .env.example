# Variáveis da stack Docker completa (compose.yaml da raiz).
# Uso: cp .env.example .env
#
# Cada app também tem seu próprio .env.example para dev local — este aqui
# alimenta a interpolação de apps/backend/compose.yaml e
# apps/frontend/compose.yaml quando a stack é subida pela raiz:
#
#   docker compose up -d --wait
#
# Serviços expostos ao host:
#   http://localhost:5173  → frontend (nginx-unprivileged, porta interna 8080)
#   http://localhost:3000  → backend: API NestJS (Swagger em /docs)
#   localhost:5432         → postgres (dev)
#   localhost:5433         → postgres-test (efêmero, só com profile "test";
#                             senhas fixas no código — não vêm daqui)
#
# DATABASE_URL não entra aqui: o compose monta a connection string a partir de
# DB_USERNAME/DB_PASSWORD (hostname `postgres` da rede Docker). Ela só existe
# no .env.example do backend, para `pnpm db:*` no dev local.

# --- Backend: obrigatórias (o compose aborta sem elas) ---
DB_USERNAME=root
DB_PASSWORD=123
# Substitua por um segredo forte: openssl rand -hex 32 (ou similar)
JWT_SECRET=your-secure-secret

# --- Backend: opcionais (defaults idênticos aos dos composes) ---
PORT=3000
# Origem do frontend que a API libera no CORS — deve casar com a porta do
# frontend no host (5173). Troque se mudar a porta do Vite/nginx.
ALLOWED_ORIGIN=http://localhost:5173
# Apesar do nome, o valor é usado como `expiresIn` do jsonwebtoken: número
# interpreta-se como SEGUNDOS, não milissegundos (não renomeie sem migrar).
JWT_EXPIRATION_MS=72000000
JWT_ISSUER=recipes-app-api

# --- Frontend (build-arg, embutido no bundle em tempo de build) ---
# URL visível ao NAVEGADOR do host — não use hostname interno da rede Docker.
VITE_API_URL=http://localhost:3000
